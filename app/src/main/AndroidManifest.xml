<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No network on purpose: without INTERNET, Android refuses to open any socket for
         this app, so nothing (app code, emulator core or a game) can send data out.
         tools:node="remove" also strips them if a library ever tries to add them back.
         Downside: games that crash when socket creation fails will crash here too. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- Games live in the app's own external files dir by default (see GamesFolder.kt),
         which needs no permission. All Files Access is only requested if the user picks
         "Other folders on this phone" in the folder browser (AllFilesAccess.kt). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Controller rumble (host Activity, SP1-C; declared now so core code never NPEs). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- SP1-B: switch from default Application to core's bootstrap. onCreate now runs:
         the Vulkan GPU probe (ProcessorInfo -> libhardware_ProcessorInfo.so, brings up
         Vulkan to read the device name), first-run asset extraction (default_config.toml +
         profile), and EAGER Emulator.load_library() on non-delay devices (Adreno 830). -->
    <application
        android:name="xendroid.compose.Application"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.xendroidCompose">
        <!-- configChanges (incl. orientation|screenSize): the layout editor FORCES the screen
             orientation via requestedOrientation so each touch layout previews as it appears
             in-game. Without this, rotating would RECREATE MainActivity (losing the editor's
             in-progress edits and reverting to landscape), which is why "Portrait" appeared to
             do nothing. Compose handles the config change via recomposition. -->
        <activity
            android:name="xendroid.compose.MainActivity"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- SP1-C: the emulator host. Separate :emu process (libe.so is single-shot
             per process; onDestroy -> System.exit(0) hard-kills it cleanly). singleTask
             so a relaunch/pinned-shortcut routes to the existing task instead of
             re-booting. Full configChanges so rotation/keyboard/etc. do NOT recreate the
             Activity (a recreate would re-enter the single-shot boot). Fullscreen theme:
             the Vulkan swapchain must own the whole window. -->
        <activity
            android:name="xendroid.compose.EmulatorHostActivity"
            android:process=":emu"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.xendroidEmu">
            <!-- In-app launch: GameLibraryViewModel.buildLaunchIntent (xendroid + setPackage). -->
            <intent-filter>
                <action android:name="xendroid.intent.action.xendroid" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Pinned-shortcut cold start: createShortcut sets action = ACTION_VIEW. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- No android:process on purpose: must land in the main process. -->
        <service
            android:name="xendroid.compose.core.MainAliveService"
            android:exported="false" />
    </application>
</manifest>
